project flux

config {
    set description "Flux is an HTTP automation testing tool"
}

globals {
    set BUILD_FOLDER build
    set TCL_LIB src/dsl.tcl
    set TCL_C src/dsl.h
    set CC gcc
    set LINK_OPTS [list -ltcl -lcrypto -lcurl]
    set TARGETS [unique-glob src/*.c src/*.h]
    set OUTPUT  ${BUILD_FOLDER}/flux
    set STANDARD_OPTS [list -std=c11 -Os -D_POSIX_C_SOURCE=200809L \
			   -Wall -Wextra -Wpedantic \
			   -Wstrict-overflow -fno-strict-aliasing]
    set DEBUG_OPTS   [list -g -O0 -DDEBUG {*}$STANDARD_OPTS]
    set RELEASE_OPTS [list -O2 -DNDEBUG -s -march=native {*}$STANDARD_OPTS]
}

task setup {
    description "Setup the build folder"
    run {
	mkdir -p $flux::BUILD_FOLDER
    }
}

task xxd {
    description "Embed Tcl into C header"
    inputs $flux::TCL_LIB
    outputs $flux::TCL_C
    run {
	xxd -i $flux::TCL_LIB > $flux::TCL_C
    }
}

task fmt {
    description "Run clang-format"
    depends_on flux::xxd
    inputs  $flux::TARGETS
    outputs .clang-format
    run {
	set -e
	clang-format -i $flux::TARGETS
	touch .clang-format
    }
}

proc build {name opts} {
    set new_out ${flux::OUTPUT}_$name

    eval [subst {
	task $name {
	    description "Build - $name"
	    depends_on flux::setup flux::fmt
	    inputs  \$flux::TARGETS
	    outputs $new_out
	    run {
		\$flux::CC \$flux::TARGETS \$flux::LINK_OPTS $opts -o $new_out
	    }
	}
    }]
}

build debug   $flux::DEBUG_OPTS
build release $flux::RELEASE_OPTS

task bear {
    description "Generate compile_commands.json"
    inputs $flux::TARGETS
    outputs compile_commands.json
    depends_on flux::debug
    run {
	bear -- [string trim $flux::debug::run]
    }
}

