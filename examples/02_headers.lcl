;; Example 2: Setting Request Headers
;;
;; This example shows how to set custom headers on requests.
;; Headers can be set individually or as a multi-line block.
;;
;; Run with: ./build/flux examples/02_headers.lcl

Flux::Suite "Request Headers" {
    Case "set headers as a block" {
        GET https://httpbin.org/headers {
            headers {
                Accept: application/json
                User-Agent: Flux/1.0
                X-Custom-Header: my-value
            }

            on_response {
                Flux::assert_eq $status_code 200

                ;; httpbin.org/headers echoes back the headers we sent

                Flux::contains? $body "Flux/1.0"
                Flux::contains? $body "my-value"
            }
        }
    }

    Case "set headers individually" {
        GET https://httpbin.org/headers {
            header "Accept: application/json"
            header "X-Custom: test-value-123"

            on_response {
                Flux::assert_eq $status_code 200
                Flux::contains? $body "test-value-123"
            }
        }
    }
}
