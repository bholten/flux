;; Example 3: POST Request with JSON Body
;;
;; This example demonstrates sending a POST request with a JSON body
;; and validating the response.
;;
;; Run with: ./build/flux examples/03_post_json.lcl

Flux::Suite "POST with JSON" {
    Flux::Case "send JSON and verify echo" {
        POST https://httpbin.org/post {
            header "Content-Type: application/json"

            body {{"username": "testuser", "email": "test@example.com"}}

            on_response {
                assert [== $status_code 200]
                ;; httpbin echoes back our posted data
                assert_contains $body "testuser"
                assert_contains $body "test@example.com"
            }
        }
    }

    Flux::Case "POST form data" {
        POST https://httpbin.org/post {
            header "Content-Type: application/x-www-form-urlencoded"

            body "name=John&age=30"

            on_response {
                assert [== $status_code 200]
                assert_status 200
                assert_contains $body "John"
            }
        }
    }
}
