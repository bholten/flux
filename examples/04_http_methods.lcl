;; Example 4: Different HTTP Methods
;;
;; Flux supports all common HTTP methods: GET, POST, PUT, PATCH, DELETE, OPTIONS, HEAD
;;
;; Run with: ./build/flux examples/04_http_methods.lcl

Flux::Suite "HTTP Methods" {
    Flux::Case "PUT request" {
        PUT https://httpbin.org/put {
            header "Content-Type: application/json"
            body {{"id": 1, "name": "Updated Item"}}

            on_response {
                assert_status 200
                assert_contains $body "Updated Item"
            }
        }
    }

    Flux::Case "PATCH request" {
        PATCH https://httpbin.org/patch {
            header "Content-Type: application/json"
            body {{"name": "Patched"}}

            on_response {
                assert_status 200
            }
        }
    }

    Flux::Case "DELETE request" {
        DELETE https://httpbin.org/delete {
            on_response {
                assert_status 200
            }
        }
    }
}
