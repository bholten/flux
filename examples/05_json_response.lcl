;; Example 5: Working with JSON Responses
;;
;; When the response Content-Type is application/json, Flux automatically
;; parses the body and makes it available as $body_json. Use `get` to access fields.
;;
;; Run with: ./build/flux examples/05_json_response.lcl

Flux::Suite "JSON Response Handling" {
    Flux::Case "access top-level JSON fields" {
        GET https://httpbin.org/get {
            on_response {
                assert_status 200

                ;; Use get for top-level fields
                let url [get $body_json url]

                assert [== $url https://httpbin.org/get]
            }
        }
    }

    Flux::Case "access nested JSON fields" {
        GET https://httpbin.org/json {
            on_response {
                assert_status 200
                ;; Navigate nested structures with multiple get calls
                let slideshow [get $body_json "slideshow"]
                let title     [get $slideshow "title"]

                assert [== $title "Sample Slide Show"]

                let author [get $slideshow "author"]

                assert [== $author "Yours Truly"]
            }
        }
    }
}
