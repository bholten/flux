;; Example 6: Response Data Variables
;;
;; The on_response callback has access to these response variables:
;; - $status_code: HTTP status code (integer)
;; - $body: Raw response body (string)
;; - $json: Parsed JSON (dict, if Content-Type is application/json)
;; - $headers: Response headers (dict)
;; - $content_type: Content-Type header value
;; - $effective_url: Final URL after redirects
;; - $total_time: Request duration in seconds
;;
;; Run with: ./build/flux examples/06_response_data.lcl

Flux::Suite "Response Data Variables" {
    Case "access status code" {
        GET https://httpbin.org/status/201 {
            on_response {
                Flux::assert_eq $status_code 201
            }
        }
    }

    Case "access body" {
        GET https://httpbin.org/html {
            on_response {
                Flux::assert_eq $status_code 200
                Flux::contains? $body "<html>"
            }
        }
    }

    Case "access parsed JSON" {
        GET https://httpbin.org/get {
            on_response {
                Flux::assert_eq $status_code 200
                let url [get $json "url"]
                Flux::assert_eq $url "https://httpbin.org/get"
            }
        }
    }

    Case "access content type" {
        GET https://httpbin.org/get {
            on_response {
                Flux::contains? $content_type "application/json"
            }
        }
    }

    Case "access timing info" {
        GET https://httpbin.org/get {
            on_response {
                Flux::assert_eq $status_code 200
                puts "Request completed in $total_time seconds"
            }
        }
    }
}
