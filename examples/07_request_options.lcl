;; Example 7: Request Options
;;
;; Flux provides various options to configure request behavior:
;; - timeout_ms: Total request timeout
;; - connection_timeout_ms: Connection establishment timeout
;; - verbose: Enable curl verbose output for debugging
;; - follow_redirects: Follow HTTP redirects
;; - ssl_verify: Control SSL certificate verification
;; - user_agent: Set the User-Agent header
;;
;; Run with: ./build/flux examples/07_request_options.lcl

Flux::Suite "Request Options" {
    Case "set timeout" {
        GET https://httpbin.org/get {
            timeout_ms 5000

            on_response {
                Flux::eq $status_code 200
            }
        }
    }

    Case "follow redirects" {
        GET https://httpbin.org/redirect/1 {
            follow_redirects 1

            on_response {
                ;; After following the redirect, we should get 200
                Flux::eq $status_code 200
            }
        }
    }

    Case "custom user agent" {
        GET https://httpbin.org/user-agent {
            user_agent "MyCustomAgent/2.0"

            on_response {
                Flux::eq $status_code 200
                Flux::contains $body "MyCustomAgent/2.0"
            }
        }
    }

    Case "verbose output for debugging" {
        GET https://httpbin.org/get {
            ;; Set verbose to 1 to see detailed curl output
            verbose 1

            on_response {
                Flux::eq $status_code 200
            }
        }
    }
}
