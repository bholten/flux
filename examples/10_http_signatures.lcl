;; Example 10: HTTP Signatures (RFC 9421)
;;
;; Flux supports signing HTTP requests per RFC 9421.
;; This enables authentication with APIs that require cryptographic signatures.
;;
;; Supported algorithms:
;;   - hmac-sha256        (symmetric, uses shared secret)
;;   - rsa-pss-sha256     (asymmetric, uses RSA private key)
;;   - rsa-pss-sha512     (asymmetric, uses RSA private key)
;;   - ecdsa-p256-sha256  (asymmetric, uses EC P-256 private key)
;;   - ecdsa-p384-sha384  (asymmetric, uses EC P-384 private key)
;;
;; Covered components use RFC 9421 names as strings:
;;   "@method", "@authority", "@path", "@query", "@target-uri"
;;   Plus any header names like "content-type", "content-digest"
;;
;; Run with: ./build/flux examples/10_http_signatures.lcl

;; Shared secret for HMAC signing (in real use, load from secure storage)
let hmac_secret "super-secret-key-for-testing-only"

;; RSA private key for RSA-PSS signing (2048-bit test key)
