Flux::Suite "HTTP Signatures" {
    Flux::Case "HMAC-SHA256 signed request" {
        POST https://httpbin.org/post {
            header "Content-Type: application/json"
            body {{"message": "Hello, signed world!"}}

            http_signature {
                key_id "test-key-1"
                key_pem $hmac_secret
                algorithm "hmac-sha256"
                cover ("@method" "@authority" "@path" "content-type")
            }

            on_response {
                assert_status 200
                assert_contains $body "Signature-Input"
                assert_contains $body "Signature"
            }
        }
    }

    Flux::Case "RSA-PSS-SHA256 signed request" {
        GET https://httpbin.org/get {
            http_signature {
                key_id "rsa-test-key"
                key_pem $rsa_key
                algorithm "rsa-pss-sha256"
                cover [list "@method" "@authority" "@path"]
            }

            on_response {
                assert_status 200
                assert_contains $body "Signature-Input"
                assert_contains $body "Signature"
            }
        }
    }

    Flux::Case "signature with custom headers" {
        POST https://httpbin.org/post {
            header "Content-Type: application/json"
            header "X-Acme-Request-Id: req-abc-123"
            header "X-Acme-Timestamp: 2024-01-15T10:30:00Z"
            body {{"action": "test"}}

            http_signature {
                key_id "acme-service-key"
                key_pem $hmac_secret
                algorithm "hmac-sha256"
                cover ("@method" "@authority" "@path" "content-type" "x-acme-request-id" "x-acme-timestamp")
            }

            on_response {
                assert_status 200
                assert_contains $body "Signature-Input"
                assert_contains $body "x-acme-request-id"
                assert_contains $body "x-acme-timestamp"
            }
        }
    }

}

Flux::configure stop_on_failure 0
Flux::run
