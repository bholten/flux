;; Example 11: Server-Sent Events (SSE) Streaming
;;
;; Flux supports consuming SSE streams using the on_event callback.
;; This enables real-time event handling from APIs that use Server-Sent Events.
;;
;; SSE event fields available in the on_event callback:
;;   $data       - the event data (string)
;;   $event_type - the event type (string, defaults to "message")
;;   $id         - the event id (string, optional)
;;   $retry      - the retry timeout in ms (string, optional)
;;
;; Additional response fields for SSE:
;;   $is_timeout    - 1 if stream ended due to timeout, 0 otherwise
;;   $error_code    - curl error code (0 = success, 28 = timeout)
;;   $error_message - error description (only present if error_code != 0)
;;   $ok            - shorthand for [== $error_code 0]
;;
;; Run with: ./build/flux examples/11_sse_streaming.lcl

;; Track received events for assertions
var event_count 0

Flux::Suite "SSE Streaming" {
    Flux::Case "should receive SSE events from stream" {
        ;; Wikipedia's "recent changes" feed — well-known public SSE
        ;; endpoint, multiple events per second, no auth.
        GET https://stream.wikimedia.org/v2/stream/recentchange {
            ;; Wikipedia requires a non-empty User-Agent (returns 403
            ;; otherwise, since libcurl by default sends none).
            user_agent "flux-example/0.1 (https://github.com/bholten/flux)"

            ;; SSE streams run until timeout or connection close.
            ;; 3s is plenty — Wikipedia produces events continuously.
            timeout_ms 3000

            on_event {
                ;; Each SSE event triggers this callback.
                ;; $data is the JSON payload; we don't print it because
                ;; each event is ~1-2 KB.
                set! event_count [+ $event_count 1]
            }

            on_response {
                puts "Stream ended after $event_count events"
                assert_status 200
                ;; A timeout is the expected end state — the stream
                ;; doesn't close itself, we let it run for timeout_ms.
                assert $is_timeout
                ;; We should have received plenty of events in 3 seconds.
                assert [> $event_count 0]
            }
        }
    }
}

Flux::run
