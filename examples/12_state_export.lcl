;; Example 12: State Export/Import
;;
;; Demonstrates sharing data between test cases using Flux::export and Flux::import.
;; This is useful for API workflows where:
;;   - One test logs in and gets an auth token
;;   - Subsequent tests use that token
;;   - One test creates a resource and gets its ID
;;   - Other tests operate on that resource
;;
;; The state is stored in-memory only - nothing touches the filesystem.
;;
;; Run with: ./build/flux examples/12_state_export.lcl

Flux::Suite "API Workflow with State" {

    Flux::Case "create a post and export its ID" {
        POST https://jsonplaceholder.typicode.com/posts {
            header "Content-Type: application/json"
            body {{"title": "Test Post", "body": "Created by Flux", "userId": 1}}

            on_response {
                Flux::eq $status_code 201

                ;; Export the created post's ID for use in later tests
                let post_id [get $json "id"]
                Flux::export "post_id" $post_id
                Flux::export "post_title" [get $json "title"]

                puts "Created post with ID: $post_id"
            }
        }
    }

    Flux::Case "verify exported data exists" {
        ;; We can check if exports exist before using them
        Flux::assert [Flux::has_export "post_id"]
        Flux::assert [Flux::has_export "post_title"]

        let id [Flux::import "post_id"]
        let title [Flux::import "post_title"]

        puts "Verified exports - ID: $id, Title: $title"

        ;; Dummy request just to have a test case with a request
        GET https://jsonplaceholder.typicode.com/posts/1 {
            on_response {
                Flux::eq $status_code 200
            }
        }
    }

    Flux::Case "use exported ID to fetch the post" {
        ;; Import the post ID from the first test
        let post_id [Flux::import "post_id"]

        ;; Note: jsonplaceholder returns 101 for created posts but doesn't persist them,
        ;; so we fetch post 1 instead to demonstrate the pattern
        GET https://jsonplaceholder.typicode.com/posts/1 {
            on_response {
                Flux::eq $status_code 200
                puts "Fetched post using exported ID pattern (actual ID: $post_id)"
            }
        }
    }

}

Flux::Suite "Auth Token Workflow" {

    Flux::Case "simulate login and export token" {
        ;; In a real scenario, this would be a login endpoint
        ;; Here we simulate by creating a fake token
        POST https://httpbin.org/post {
            header "Content-Type: application/json"
            body {{"username": "testuser", "password": "secret"}}

            on_response {
                Flux::eq $status_code 200

                ;; Simulate receiving a token (httpbin echoes back our request)
                let fake_token "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.test"
                Flux::export "auth_token" $fake_token
                Flux::export "user_id" "user_12345"

                puts "Logged in, token exported"
            }
        }
    }

    Flux::Case "make authenticated request using exported token" {
        let token [Flux::import "auth_token"]
        let user_id [Flux::import "user_id"]

        GET https://httpbin.org/headers {
            header "Authorization: Bearer $token"
            header "X-User-Id: $user_id"

            on_response {
                Flux::eq $status_code 200

                ;; Verify our headers were sent
                Flux::contains $body "Bearer"
                Flux::contains $body $user_id

                puts "Authenticated request successful"
            }
        }
    }

}

Flux::Suite "Clear State Demo" {

    Flux::Case "exports persist across suites" {
        ;; The auth_token from the previous suite should still be available
        Flux::assert [Flux::has_export "auth_token"]
        puts "State persists across suites: token exists"

        GET https://httpbin.org/get {
            on_response { Flux::eq $status_code 200 }
        }
    }

    Flux::Case "clear exports when done" {
        Flux::clear_exports

        ;; Now the exports should be gone
        Flux::assert [not [Flux::has_export "auth_token"]]
        Flux::assert [not [Flux::has_export "post_id"]]

        puts "State cleared successfully"

        GET https://httpbin.org/get {
            on_response { Flux::eq $status_code 200 }
        }
    }

}

Flux::run
