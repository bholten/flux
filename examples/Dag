;; Run all the suites
;; Shows easy integration with Dagwood

proc _generate_tasks {} {
    ;; setup out dir
    task pre_reqs {
        outputs .out/
        run {
            mkdir -p .out/
        }
    }

    let suites [Posix::glob *.lcl]

    ;; Each task touches its output on success
    foreach s $suites {
        let out .out/$s.xml

        task $s {
            depends-on flux_suites::pre_reqs
            inputs $s
            outputs $out
            run [subst {
                dache cache -i $s -o $out -- sh -c "flux --junit $s > $out"
                touch $out
            }]
        }
    }

    ;; Clean command
    command clean {
        run {
            rm -rf .out/
        }
    }
}


project flux_suites {
    _generate_tasks
}
