;;; Flux - HTTP Testing Framework DSL
namespace Flux {
    var _config #{stop_on_failure 0 output_format "human"}

    var _suites ()
    var _current_suite {}
    var _current_cases ()

    var _results ()
    var _failed 0

    ;; The cache lives in a nested namespace so its mutation point is
    ;; explicit at every call site — bare `_store` would resolve via
    ;; def-target chain and read as if it were a local. The fully
    ;; qualified `Flux::State::_store` makes it visually obvious that
    ;; we're poking shared state across a namespace boundary.
    namespace State {
        var _store #{}
    }

    ;;; Set a value in the Flux cache. Used for setting values across test cases within a single harness; for example, reusing a generated auth token.
    proc cache_set {name value} {
        set! Flux::State::_store [put ${Flux::State::_store} $name $value]
    }

    ;; Get a value in the Flux cache. Used for getting values across test cses within a single harness; for example, reusing a generated auth token.
    proc cache_get {name} {
        if [has? ${Flux::State::_store} $name] {
            return [get ${Flux::State::_store} $name]
        }

        error "Flux::cache_get: no value cached under '$name'"
    }

    ;; Check if a value is in the Flux cache.
    proc cache_has? {name} {
        has? ${Flux::State::_store} $name
    }

    ;; Clear the Flux cache.
    proc cache_clear {} {
        set! Flux::State::_store [dict]
    }

    ;;; Memoize a block under a key. Body runs in the caller's frame on a
    ;;; cache miss; on a hit, returns the cached value without re-running.
    ;;; Convention: the body's last expression IS the cached value — `return`
    ;;; would unwind the enclosing user proc and bypass cache_set.
    macro cache {key body} {
        let k [gensym _cache_key]
        let v [gensym _cache_val]
        quasiquote {
            let ,$k ,$key
            if [Flux::cache_has? $,$k] {
                Flux::cache_get $,$k
            } else {
                let ,$v [eval {,$body}]
                Flux::cache_set $,$k $,$v
                $,$v
            }
        }
    }

    ;;; JSON pointer.
    proc json_at {data pointer} {
        if [== $pointer ""] { return $data }
        if [== $pointer "/"] { return $data }

        if [!= [String::range $pointer 0 1] "/"] {
            error "JSON pointer must start with /"
        }

        var node $data
        let parts [String::split $pointer "/"]
        let segments [List::slice $parts 1 [len $parts]]

        foreach raw $segments {
            ;; Unescape ~1 -> / and ~0 -> ~
            let seg [-> $raw {String::replace "~1" "/"}
                             {String::replace "~0" "~"}]

            if [has? $node $seg] {
                set! node [get $node $seg]
            } else {
                if [list? $node] {
                    let idx [int $seg]
                    if [< $idx [len $node]] {
                        set! node [get $node $idx]
                    } else {
                        error "JSON pointer path not found: $pointer"
                    }
                } else {
                    error "JSON pointer path not found: $pointer"
                }
            }
        }

        return $node
    }

    proc _parse_url {url} {
        var scheme {}
        var authority {}
        var path "/"
        var query {}
        var rest $url
        let scheme_end [String::find $rest "://"]

        if [>= $scheme_end 0] {
            set! scheme [String::range $rest 0 $scheme_end]
            set! rest [String::range $rest [+ $scheme_end 3] [String::length $rest]]
        }

        let path_start [String::find $rest "/"]

        if [>= $path_start 0] {
            set! authority [String::range $rest 0 $path_start]
            set! rest [String::range $rest $path_start [String::length $rest]]
        } else {
            set! authority $rest
            set! rest "/"
        }

        let query_start [String::find $rest "?"]

        if [>= $query_start 0] {
            set! path [String::range $rest 0 $query_start]
            set! query [String::range $rest [+ $query_start 1] [String::length $rest]]
        } else {
            set! path $rest
        }

        return [dict scheme $scheme authority $authority path $path query $query]
    }

    proc _build_request_target {url_parts} {
        let p [get $url_parts path]
        let q [get $url_parts query]

        if [not [empty? $q]] {
            return "$p?$q"
        }

        return $p
    }

    proc _build_content_digest {body} {
        if [empty? $body] { return {} }

        let hash [Crypto::sha256 $body]

        return [String::join ({sha-256=:} $hash {:}) {}]
    }

    proc _get_header_value {headers_dict component} {
        let lower_component [String::lower $component]

        if [has? $headers_dict $lower_component] {
            return [get $headers_dict $lower_component]
        }

        return {}
    }

    proc _build_signature_base {verb url headers_dict body covered_components sig_params} {
        var lines [list]
        let url_parts [_parse_url $url]

        foreach component $covered_components {
            let value [cond
                       [== $component "@method"] [String::upper $verb]
                       [== $component "@authority"] [get $url_parts authority]
                       [== $component "@scheme"] [get $url_parts scheme]
                       [== $component "@path"] [get $url_parts path]
                       [== $component "@query"] [get $url_parts query]
                       [== $component "@target-uri"] $url
                       [== $component "@request-target"] [_build_request_target $url_parts]
                       [== $component "content-digest"] [_build_content_digest $body]
                       else [_get_header_value $headers_dict $component]]

            let line "\"$component\": $value"

            set! lines [List::push $lines $line]
        }

        set! lines [List::push $lines "\"@signature-params\": $sig_params"]

        return [String::join $lines "\n"]
    }

    proc _build_sig_params {covered_components key_id algorithm created} {
        var component_list [list]

        foreach c $covered_components {
            set! component_list [List::push $component_list "\"$c\""]
        }

        let components_str [String::join $component_list " "]

        return "($components_str);created=$created;keyid=\"$key_id\";alg=\"$algorithm\""
    }

    proc _get_unix_time {} {
        let ts [Time::time]
        return $ts
    }

    proc _apply_http_signature {verb url headers_list body sig_config} {
        let key_id [get $sig_config key_id]
        let key_pem [get $sig_config key_pem]
        let algorithm [get $sig_config algorithm]
        let covered [get $sig_config covered_components]
        let sig_name [get $sig_config name]
        let created [_get_unix_time]
        let sig_params [_build_sig_params $covered $key_id $algorithm $created]
        var headers_dict #{}

        foreach h $headers_list {
            let colon_pos [String::find $h ":"]

            if [>= $colon_pos 0] {
                let name [String::lower [String::trim [String::range $h 0 $colon_pos]]]
                let val [String::trim [String::range $h [+ $colon_pos 1] [String::length $h]]]
                set! headers_dict [put $headers_dict $name $val]
            }
        }

        let sig_base [_build_signature_base $verb $url $headers_dict $body $covered $sig_params]

        let signature [case $algorithm
                       {hmac-sha256}       [Crypto::hmac $key_pem $sig_base sha256]
                       {rsa-pss-sha256}    [Crypto::sign_rsa_pss $key_pem $sig_base sha256]
                       {rsa-pss-sha512}    [Crypto::sign_rsa_pss $key_pem $sig_base sha512]
                       {ecdsa-p256-sha256} [Crypto::sign_ecdsa $key_pem $sig_base p256]
                       {ecdsa-p384-sha384} [Crypto::sign_ecdsa $key_pem $sig_base p384]
                       else [error "Unsupported signature algorithm: $algorithm"]]

        let sig_b64 [Crypto::base64_encode $signature]
        var new_headers $headers_list

        let sig_input_hdr [String::join ({Signature-Input: } $sig_name {=} $sig_params) {}]
        let sig_hdr [String::join ({Signature: } $sig_name {=:} $sig_b64 {:}) {}]

        set! new_headers [List::push $new_headers $sig_input_hdr]
        set! new_headers [List::push $new_headers $sig_hdr]

        return $new_headers
    }

    proc _execute_request {verb url request_config on_event_callback} {
        ;; Curl::init wraps curl_global_init which is idempotent — safe to
        ;; call per request. The handle from Curl::new is an opaque value;
        ;; its destructor (curl_easy_cleanup + slist/callback teardown)
        ;; runs automatically when refcount hits 0 at proc exit, including
        ;; on the error path. No shared mutable state between requests.
        Curl::init
        let c [Curl::new]

        Curl::set_url $c $url
        Curl::set_verb $c $verb

        ;; HEAD needs CURLOPT_NOBODY=1 in addition to the custom verb,
        ;; otherwise curl reads the body the server (incorrectly) sends
        ;; and trips CURLE_PARTIAL_FILE on the Content-Length mismatch.
        if [== $verb "HEAD"] {
            Curl::set_nobody $c 1
        }

        var body {}

        if [has? $request_config body] {
            set! body [get $request_config body]
        }

        var headers_list [list]

        if [has? $request_config headers] {
            set! headers_list [get $request_config headers]
        }

        if [has? $request_config http_signature] {
            set! headers_list [_apply_http_signature $verb $url $headers_list $body [get $request_config http_signature]]
        }

        foreach h $headers_list {
            Curl::set_header $c $h
        }

        if [not [empty? $body]] {
            Curl::set_body $c $body
        }

        if [has? $request_config options] {
            let opts [get $request_config options]

            if [has? $opts timeout_ms] {
                Curl::set_timeout_ms $c [get $opts timeout_ms]
            }

            if [has? $opts connection_timeout_ms] {
                Curl::set_connection_timeout_ms $c [get $opts connection_timeout_ms]
            }

            if [has? $opts accept_timeout_ms] {
                Curl::set_accept_timeout_ms $c [get $opts accept_timeout_ms]
            }

            if [has? $opts verbose] {
                Curl::set_verbose $c [get $opts verbose]
            }

            if [has? $opts follow_location] {
                Curl::set_follow_location $c [get $opts follow_location]
            }

            if [has? $opts ssl_verify_peer] {
                Curl::set_ssl_verify_peer $c [get $opts ssl_verify_peer]
            }

            if [has? $opts ssl_verify_host] {
                Curl::set_ssl_verify_host $c [get $opts ssl_verify_host]
            }

            if [has? $opts user_agent] {
                Curl::set_user_agent $c [get $opts user_agent]
            }
        }

        var response_body {}
        var captured_headers #{}

        ;; Parse each response-header line and accumulate into captured_headers
        ;; as { lowercase_name -> [list value ...] }. A status line (starting
        ;; with "HTTP/") resets the dict so that on followed redirects only the
        ;; final response's headers survive.
        Curl::set_header_callback $c [lambda {line} {
            let trimmed [String::trim $line]
            if [empty? $trimmed] {
            } else {
                if [== [String::find $trimmed "HTTP/"] 0] {
                    set! captured_headers #{}
                } else {
                    let colon_idx [String::find $trimmed ":"]
                    if [>= $colon_idx 0] {
                        let name [String::trim [String::range $trimmed 0 $colon_idx]]
                        let value [String::trim [String::range $trimmed [+ $colon_idx 1] [String::length $trimmed]]]
                        let key [String::lower $name]
                        var existing [list]
                        if [has? $captured_headers $key] {
                            set! existing [get $captured_headers $key]
                        }
                        set! captured_headers [put $captured_headers $key [List::push $existing $value]]
                    }
                }
            }
        }]

        if [not [empty? $on_event_callback]] {
            Curl::set_sse_callback $c [lambda {event} {
                var data {}
                var event_type {}
                var id {}
                var retry {}

                if [has? $event data] {
                    set! data [get $event data]
                }

                if [has? $event event] {
                    set! event_type [get $event event]
                }

                if [has? $event id] {
                    set! id [get $event id]
                }

                if [has? $event retry] {
                    set! retry [get $event retry]
                }

                eval $on_event_callback
            }]
        } else {
            Curl::set_write_callback $c [lambda {chunk} {
                set! response_body "$response_body$chunk"
            }]
        }

        var perform_failed 0

        if [catch {Curl::perform $c} _result _err] {
            set! perform_failed 1
        }

        let is_timeout [Curl::is_timeout $c]
        let error_code [Curl::get_last_error $c]
        let error_string [Curl::error_string $c]

        if [and $perform_failed [not $is_timeout]] {
            if [empty? $on_event_callback] {
                error "curl request failed: $error_string"
            }
            ;; SSE with non-timeout error - we'll report it in the response
        }

        let status_code [Curl::get_response_code $c]
        let content_type [Curl::get_content_type $c]
        let effective_url [Curl::get_effective_url $c]
        let total_time [Curl::get_total_time $c]

        var headers $captured_headers

        ;; Belt-and-suspenders: if the header callback didn't see content-type
        ;; (e.g. some transport edge case), backfill from libcurl's reported
        ;; value so $content_type and $headers stay consistent.
        if [and [not [empty? $content_type]] [not [has? $headers "content-type"]]] {
            set! headers [put $headers "content-type" [list $content_type]]
        }

        var parsed_json {}

        if [>= [String::find $content_type "application/json"] 0] {
            if [catch {Json::decode $response_body} result _err] {
                ;; JSON parse failed, leave parsed_json empty
            } else {
                set! parsed_json $result
            }
        }

        var response #{
            status_code $status_code
            body $response_body
            json $parsed_json
            headers $headers
            content_type $content_type
            effective_url $effective_url
            total_time $total_time
            error_code $error_code
            error_message {}
            is_timeout $is_timeout
            ok [== $error_code 0]
        }

        if [!= $error_code 0] {
            set! response [put $response error_message $error_string]
        }

        return $response
    }

    proc _build_request {syntax_body} {
        var config #{headers () options #{}}
        var on_response_callback {}
        var on_event_callback {}

        ;; The DSL verbs (header/body/timeout_ms/etc.) are top-level macros
        ;; that expand into `set! config [put ...]` writes against this
        ;; frame's locals — see the bottom of this file. http_signature
        ;; remains a proc because its sub-DSL (key_id, algorithm, name,
        ;; cover, ...) uses names too generic to safely globalize.

        proc http_signature {sig_body} {
            var sig_config [dict name "sig" covered_components [list]]

            proc key_id {id} {
                set! sig_config [put $sig_config key_id $id]
            }

            proc key_pem {pem} {
                set! sig_config [put $sig_config key_pem $pem]
            }

            proc key_file {path} {
                let pem [Io::read_file $path]
                set! sig_config [put $sig_config key_pem $pem]
            }

            proc algorithm {alg} {
                set! sig_config [put $sig_config algorithm $alg]
            }

            proc name {n} {
                set! sig_config [put $sig_config name $n]
            }

            proc cover {components} {
                set! sig_config [put $sig_config covered_components $components]
            }

            eval $sig_body

            set! config [put $config http_signature $sig_config]
        }

        eval $syntax_body

        return #{
            config $config
            on_response $on_response_callback
            on_event $on_event_callback
        }
    }

    proc _make_request {verb url syntax_body} {
        let built [_build_request $syntax_body]
        let config [get $built config]
        let on_response_cb [get $built on_response]
        let on_event_cb [get $built on_event]

        let response [_execute_request $verb $url $config $on_event_cb]

        if [not [empty? $on_response_cb]] {
            ;; Magic vars in on_response scope. Also: $response (whole dict).
            let status_code    [get $response status_code]
            let body           [get $response body]
            let json           [get $response json]
            let headers        [get $response headers]
            let content_type   [get $response content_type]
            let effective_url  [get $response effective_url]
            let total_time     [get $response total_time]
            let is_timeout     [get $response is_timeout]
            let error_code     [get $response error_code]
            let error_message  [get $response error_message]
            let ok             [get $response ok]

            eval $on_response_cb
        }

        return $response
    }

    ;;; Starts a Flux::Suite block with name and body.
    proc Suite {name suite_body} {
        let prev_cases $_current_cases
        let prev_suite $_current_suite
        set! _current_cases ()
        set! _current_suite $name

        eval $suite_body

        let suite #{name $name cases $_current_cases}
        set! _suites [List::push $_suites $suite]

        set! _current_cases $prev_cases
        set! _current_suite $prev_suite
    }

    ;;; Starts a Flux::Case within a suite.
    proc Case {name case_body} {
        let case_def #{name $name body $case_body}
        set! _current_cases [List::push $_current_cases $case_def]
    }

    proc _format_time_us {us} {
        if [< $us 1000] {
            return "${us}us"
        }
        if [< $us 1000000] {
            let ms [int [/ $us 1000]]
            return "${ms}ms"
        }
        let ms [int [/ $us 1000]]
        let secs [int [/ $ms 1000]]
        let frac [int [% $ms 1000]]
        if [< $frac 10]  { return "${secs}.00${frac}s" }
        if [< $frac 100] { return "${secs}.0${frac}s" }
        return "${secs}.${frac}s"
    }

    proc _format_time_seconds {us} {
        let ms [int [/ $us 1000]]
        let secs [int [/ $ms 1000]]
        let frac [int [% $ms 1000]]

        if [< $frac 10] {
            return "${secs}.00${frac}"
        }

        if [< $frac 100] {
            return "${secs}.0${frac}"
        }

        return "${secs}.${frac}"
    }

    proc _xml_escape {str} {
        var result $str
        set! result [String::replace $result "&" "&amp;"]
        set! result [String::replace $result "<" "&lt;"]
        set! result [String::replace $result ">" "&gt;"]
        set! result [String::replace $result "\"" "&quot;"]
        set! result [String::replace $result "'" "&apos;"]
        return $result
    }

    proc _emit_human {results} {
        let suites [get $results suites]
        let total [get $results total]
        let passed [get $results passed]
        let failed [get $results failed]
        let time_us [get $results time_us]

        puts ""
        puts "Running Flux test suites..."
        puts ""

        foreach suite $suites {
            let suite_name [get $suite name]
            let cases [get $suite cases]
            let suite_time [get $suite time_us]

            puts "Suite: $suite_name"

            foreach case_result $cases {
                let case_name [get $case_result name]
                let status [get $case_result status]
                let case_time [get $case_result time_us]
                let time_str [Flux::_format_time_us $case_time]

                if [== $status "passed"] {
                    puts "  PASS: $case_name ($time_str)"
                } else {
                    let err [get $case_result error]
                    puts "  FAIL: $case_name ($time_str)"
                    puts "        $err"
                }
            }

            let suite_time_str [Flux::_format_time_us $suite_time]
            puts "  Suite time: $suite_time_str"
             puts ""
        }

        let total_time_str [Flux::_format_time_us $time_us]

        puts "----------------------------------------"
        puts "Total: $total, Passed: $passed, Failed: $failed"
        puts "Total time: $total_time_str"

        if [> $failed 0] {
            puts ""
            puts "Some tests failed."
        } else {
            puts ""
            puts "All tests passed!"
        }
    }

    proc _emit_junit {results} {
        let suites [get $results suites]
        let total [get $results total]
        let failed [get $results failed]
        let time_us [get $results time_us]
        let time_secs [Flux::_format_time_seconds $time_us]

        puts {<?xml version="1.0" encoding="UTF-8"?>}
        puts "<testsuites tests=\"$total\" failures=\"$failed\" time=\"$time_secs\">"

        foreach suite $suites {
            let suite_name [Flux::_xml_escape [get $suite name]]
            let cases [get $suite cases]
            let suite_time [get $suite time_us]
            let suite_time_secs [Flux::_format_time_seconds $suite_time]

            var suite_tests 0
            var suite_failures 0
            foreach c $cases {
                set! suite_tests [+ $suite_tests 1]
                if [== [get $c status] "failed"] {
                    set! suite_failures [+ $suite_failures 1]
                }
            }

            puts "  <testsuite name=\"$suite_name\" tests=\"$suite_tests\" failures=\"$suite_failures\" time=\"$suite_time_secs\">"

            foreach case_result $cases {
                let case_name [Flux::_xml_escape [get $case_result name]]
                let status [get $case_result status]
                let case_time [get $case_result time_us]
                let case_time_secs [Flux::_format_time_seconds $case_time]

                if [== $status "passed"] {
                    puts "    <testcase name=\"$case_name\" time=\"$case_time_secs\"/>"
                } else {
                    let err [Flux::_xml_escape [get $case_result error]]
                    puts "    <testcase name=\"$case_name\" time=\"$case_time_secs\">"
                    puts "      <failure message=\"$err\"/>"
                    puts "    </testcase>"
                }
            }

            puts "  </testsuite>"
        }

        puts "</testsuites>"
    }

    ;;; Run the accumulated Flux suites.
    proc run {} {
        ;; Idempotent: the user file may end with an explicit `Flux::run` AND
        ;; the C entry point also invokes us via `interpreter_execute`. The
        ;; first call drains _suites; subsequent calls find it empty and
        ;; return without emitting anything.
        if [empty? $_suites] {
            return #{suites () total 0 passed 0 failed 0 time_us 0}
        }

        set! _failed 0
        set! _results ()

        ;; CLI options (bound at the top level by the C entry point, after
        ;; this library loads — hence the live ::-reference) take precedence
        ;; over in-file Flux::configure calls — `--junit` should override
        ;; whatever the test file said.
        foreach k [Dict::keys ${::_flux_cli_opts}] {
            Flux::configure $k [get ${::_flux_cli_opts} $k]
        }

        let stop_on_failure [get $_config stop_on_failure]
        let output_format [get $_config output_format]

        var total_cases 0
        var passed_cases 0
        var failed_cases 0
        var suite_results ()

        ;; Timing metrics
        let run_start [Time::monotonic_us]

        foreach suite $_suites {
            let suite_name [get $suite name]
            let cases [get $suite cases]
            let suite_start [Time::monotonic_us]
            var case_results ()

            foreach case_def $cases {
                let case_name [get $case_def name]
                let case_body [get $case_def body]
                let case_start [Time::monotonic_us]

                set! total_cases [+ $total_cases 1]

                if [catch { isolate { eval $case_body } } _result _err] {
                    let case_end [Time::monotonic_us]
                    let case_time [- $case_end $case_start]

                    set! failed_cases [+ $failed_cases 1]
                    set! _failed 1

                    let result #{status "failed" name $case_name error $_err time_us $case_time}
                    set! case_results [List::push $case_results $result]
                    set! _results [List::push $_results $result]

                    if $stop_on_failure {
                        break
                    }
                } else {
                    let case_end [Time::monotonic_us]
                    let case_time [- $case_end $case_start]

                    set! passed_cases [+ $passed_cases 1]

                    let result #{status "passed" name $case_name time_us $case_time}
                    set! case_results [List::push $case_results $result]
                    set! _results [List::push $_results $result]
                }
            }

            let suite_end [Time::monotonic_us]
            let suite_time [- $suite_end $suite_start]

            let suite_result #{name $suite_name cases $case_results time_us $suite_time}
            set! suite_results [List::push $suite_results $suite_result]

            if [and $stop_on_failure $_failed] {
                break
            }
        }

        let run_end [Time::monotonic_us]
        let total_time [- $run_end $run_start]

        let results #{
            suites $suite_results
            total $total_cases
            passed $passed_cases
            failed $failed_cases
            time_us $total_time
        }

        if [== $output_format "junit"] {
            Flux::_emit_junit $results
        } else {
            Flux::_emit_human $results
        }

        ;; Drain so the implicit second invocation from interpreter_execute
        ;; becomes a silent no-op (see the empty-_suites short-circuit above).
        set! _suites ()

        return $results
    }

    proc configure {option value} {
        set! _config [put $_config $option $value]
    }
}


proc GET {url (syntax_body {})} {
    let result [Flux::_make_request "GET" $url $syntax_body]
    return $result
}

proc POST {url (syntax_body {})} {
    let result [Flux::_make_request "POST" $url $syntax_body]
    return $result
}

proc PUT {url (syntax_body {})} {
    let result [Flux::_make_request "PUT" $url $syntax_body]
    return $result
}

proc DELETE {url (syntax_body {})} {
    let result [Flux::_make_request "DELETE" $url $syntax_body]
    return $result
}

proc PATCH {url (syntax_body {})} {
    let result [Flux::_make_request "PATCH" $url $syntax_body]
    return $result
}

proc OPTIONS {url (syntax_body {})} {
    let result [Flux::_make_request "OPTIONS" $url $syntax_body]
    return $result
}

proc HEAD {url (syntax_body {})} {
    let result [Flux::_make_request "HEAD" $url $syntax_body]
    return $result
}


;; ===========================================================================
;; Request-DSL macros — header, body, timeout_ms, on_response, etc.
;;
;; These expand inside _build_request's frame (the body of GET/POST/etc.'s
;; `{ ... }` argument is eval'd there), so they write directly to that
;; frame's `config`, `on_response_callback`, `on_event_callback` locals
;; without per-call closure allocations.
;; ===========================================================================

macro header {h} {
    quasiquote {
        set! config [put $config headers [List::push [get $config headers] {,$h}]]
    }
}

macro headers {hds} {
    let line [gensym _hdr_line]
    let trimmed [gensym _hdr_trimmed]
    quasiquote {
        foreach ,$line [String::split {,$hds} "\n"] {
            let ,$trimmed [String::trim $,$line]
            if [not [empty? $,$trimmed]] {
                set! config [put $config headers [List::push [get $config headers] $,$trimmed]]
            }
        }
    }
}

macro body {b} {
    quasiquote { set! config [put $config body {,$b}] }
}

macro timeout_ms {ms} {
    quasiquote {
        set! config [put $config options [put [get $config options] timeout_ms {,$ms}]]
    }
}

macro connection_timeout_ms {ms} {
    quasiquote {
        set! config [put $config options [put [get $config options] connection_timeout_ms {,$ms}]]
    }
}

macro accept_timeout_ms {ms} {
    quasiquote {
        set! config [put $config options [put [get $config options] accept_timeout_ms {,$ms}]]
    }
}

macro verbose {v} {
    quasiquote {
        set! config [put $config options [put [get $config options] verbose {,$v}]]
    }
}

macro follow_redirects {v} {
    quasiquote {
        set! config [put $config options [put [get $config options] follow_location {,$v}]]
    }
}

macro ssl_verify {peer host} {
    let opts [gensym _ssl_opts]
    quasiquote {
        let ,$opts [get $config options]
        set! ,$opts [put $,$opts ssl_verify_peer {,$peer}]
        set! ,$opts [put $,$opts ssl_verify_host {,$host}]
        set! config [put $config options $,$opts]
    }
}

macro ssl_verify_peer {peer} {
    quasiquote {
        set! config [put $config options [put [get $config options] ssl_verify_peer {,$peer}]]
    }
}

macro user_agent {ua} {
    quasiquote {
        set! config [put $config options [put [get $config options] user_agent {,$ua}]]
    }
}

macro on_response {callback_body} {
    quasiquote { set! on_response_callback {,$callback_body} }
}

;; SSE event callback. The body is evaluated once per event with magic
;; vars: $data, $event_type, $id, $retry.
macro on_event {callback_body} {
    quasiquote { set! on_event_callback {,$callback_body} }
}


;; ===========================================================================
;; Assertion macros (top-level, expand in caller's frame so they read the
;; on_response magic vars — $status_code, $headers, $body, $json,
;; $is_timeout, $error_code, $error_message — without the caller passing
;; them).
;;
;; Quasiquote splices have a subtle rule: `,$arg` inserts the macro arg's
;; *value bytes* into the template. For values that may contain whitespace
;; (HTTP bodies, header names, JSON expected values) we wrap with `{,$arg}`
;; so the value lands as a single token. The braces are inert when the slot
;; expects a value (integers, strings, even lists — `{200 201 202}` is
;; accepted by `List::any?` as a list).
;;
;; Error messages are built with `[String::join (...) ""]` because commas
;; inside "..." are literal during quasiquote (Lcl spec §7b note).
;; ===========================================================================

;; Status code equals $expected.
macro assert_status {expected} {
    quasiquote {
        if [!= $status_code {,$expected}] {
            error [String::join ("assert_status: expected " {,$expected} " but got " $status_code) ""]
        }
    }
}

;; Status code is one of the values in $expected_list (a list).
;;   assert_status_in (200 201 202)
;;   assert_status_in $allowed
macro assert_status_in {expected_list} {
    let l [gensym _allowed]
    quasiquote {
        let ,$l [list ,@$expected_list]
        if [not [List::any? $,$l [lambda {_s} {== $_s $status_code}]]] {
            error [String::join ("assert_status_in: status " $status_code " not in " $,$l) ""]
        }
    }
}

;; $haystack contains $needle as a substring.
macro assert_contains {haystack needle} {
    quasiquote {
        if [< [String::find {,$haystack} {,$needle}] 0] {
            error [String::join ("assert_contains: body does not contain <" {,$needle} ">") ""]
        }
    }
}

;; $string matches POSIX regex $pattern (anywhere in the string).
macro assert_match {pattern string} {
    quasiquote {
        if [not [Regex::match {,$pattern} {,$string}]] {
            error [String::join ("assert_match: body does not match /" {,$pattern} "/") ""]
        }
    }
}

;; Header $name is present in $headers (case-insensitive).
macro assert_header {name} {
    quasiquote {
        if [not [has? $headers [String::lower {,$name}]]] {
            error [String::join ("assert_header: header <" {,$name} "> not in response") ""]
        }
    }
}

;; Header $name is present in $headers and its first value equals $expected.
macro assert_header_eq {name expected} {
    let k [gensym _hkey]
    let a [gensym _hactual]
    quasiquote {
        let ,$k [String::lower {,$name}]
        if [not [has? $headers $,$k]] {
            error [String::join ("assert_header_eq: header <" {,$name} "> not in response") ""]
        }
        let ,$a [get [get $headers $,$k] 0]
        if [!= $,$a {,$expected}] {
            error [String::join ("assert_header_eq: header <" {,$name} ">: expected <" {,$expected} "> got <" $,$a ">") ""]
        }
    }
}

;; The JSON pointer $pointer (RFC 6901) resolves in $json and equals
;; $expected (deep equality).
macro assert_json {pointer expected} {
    let a [gensym _jactual]
    quasiquote {
        let ,$a [Flux::json_at $json {,$pointer}]
        if [!= $,$a {,$expected}] {
            error [String::join ("assert_json: at " {,$pointer} ": expected <" {,$expected} "> got <" $,$a ">") ""]
        }
    }
}

;; The JSON pointer $pointer resolves to a value in $json (any value;
;; just checks the path exists). Wraps Flux::json_at in catch so a missing
;; path errors with the assertion's message rather than json_at's raw error.
macro assert_json_has {pointer} {
    quasiquote {
        if [catch {Flux::json_at $json {,$pointer}} _r _e] {
            error [String::join ("assert_json_has: pointer " {,$pointer} " not found in json") ""]
        }
    }
}

;; The request reached the server without a transport error: not a timeout
;; and curl returned a zero error code. Useful for SSE tests, where curl
;; surfaces termination via the response dict rather than throwing.
macro assert_response_ok {} {
    quasiquote {
        if $is_timeout {
            error "assert_response_ok: request timed out"
        }
        if [not $ok] {
            error [String::join ("assert_response_ok: error_code " $error_code ": " $error_message) ""]
        }
    }
}
