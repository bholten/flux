;; Exercise the remaining assertion macros — assert_contains, assert_match,
;; assert_response_ok, and bare `assert`. The status / header / json
;; macros are covered in their own files.

let base "http://localhost:8080"

Flux::Suite "Assertions" {
    Flux::Case "assert_contains against body" {
        GET "$base/" {
            on_response {
                assert_status 200
                ;; The echoed body always contains the request method
                ;; string and the protocol literal.
                assert_contains $body "method"
                assert_contains $body "http"
            }
        }
    }

    Flux::Case "assert_match against body (regex)" {
        GET "$base/?echo_body=user-42" {
            on_response {
                assert_status 200
                ;; Use braces around regex patterns containing `[...]` —
                ;; double-quoted strings would try to command-substitute
                ;; the bracketed range.
                assert_match {user-[0-9]+} $body
            }
        }
    }

    Flux::Case "assert_response_ok on success" {
        GET "$base/" {
            on_response {
                assert_response_ok
                assert_status 200
            }
        }
    }

    Flux::Case "bare assert for ad-hoc checks" {
        GET "$base/" {
            on_response {
                assert_status 200
                assert [> [String::length $body] 0]
                assert [not [empty? $body_json]]
            }
        }
    }
}
