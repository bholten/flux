# Test Flux::json_at directly

let test_data [json::decode {{"name": "test", "nested": {"value": 42}}}]
puts "Data: $test_data"

puts "Testing Flux::json_at with /name..."
let name [Flux::json_at $test_data "/name"]
puts "Name: $name"

puts "Testing Flux::json_at with /nested/value..."
let value [Flux::json_at $test_data "/nested/value"]
puts "Value: $value"
