# Debug - check body vs json

GET https://httpbin.org/get {
    on_response {
        puts "=== Response Debug ==="
        puts "Status: $status_code"
        puts "Body length: [String::length $body]"
        puts "JSON empty?: [empty? $json]"
        puts "Content-Type: $content_type"

        # Try parsing manually
        puts "Manually parsing body..."
        let manual_json [json::decode $body]
        puts "Manual parse result:"
        puts $manual_json
        let url [get $manual_json "url"]
        puts "URL: $url"
    }
}
