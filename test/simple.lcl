# Simple test to verify DSL loads correctly

Flux::Suite "Basic Tests" {
    Flux::Case "HTTP request to httpbin" {
        GET https://httpbin.org/get {
            headers {
                Accept: application/json
                User-Agent: Flux/1.0
            }

            on_response {
                Flux::eq $status_code 200
                puts "Got status: $status_code"
                puts "Content-Type: $content_type"
            }
        }
    }
}
