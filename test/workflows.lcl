;; Exercise the Flux::cache memoization API and the workflow-procs-
;; return-values pattern (the recommended cross-Case state sharing).

let base "http://localhost:8080"

namespace flow {
    proc get_http_method {} {
        Flux::cache "flow:method" {
            var method ""
            GET "http://localhost:8080/" {
                on_response {
                    assert_status 200
                    set! method [get [get $body_json "http"] "method"]
                }
            }
            $method
        }
    }
}

Flux::Suite "Workflow memoization" {
    Flux::Case "first call hits the API" {
        let m [flow::get_http_method]
        assert [== $m "GET"]
    }

    Flux::Case "second call returns cached value" {
        let m [flow::get_http_method]
        assert [== $m "GET"]
        assert [Flux::cache_has? "flow:method"]
    }

    Flux::Case "cache_clear empties the store" {
        Flux::cache_clear
        assert [not [Flux::cache_has? "flow:method"]]
    }
}
